# Aplicação
APP_ENV=local
LOG_LEVEL=INFO
DATA_DIR=emporio_musica/data
POLICY_PDF=emporio_musica/data/políticas_da_loja.pdf
POLICY_CACHE=data/policy_chunks.json
LOCAL_MODE=true

# Data de referência para prazos. Vazio usa a data real.
# Para reproduzir os exemplos de devolução, use 2026-02-20.
STORE_TODAY=

# LLM
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Supabase (opcional no modo local)
SUPABASE_DB_URL=

# Limites
MAX_HISTORY=12
MAX_TOOL_ITERATIONS=5
LLM_TIMEOUT_SECONDS=30
